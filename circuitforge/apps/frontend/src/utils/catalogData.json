      }
    ],
    "wiring_rules": [
      {
        "from_pin": "VCC",
        "to_component": "esp32",
        "to_pin": "3V3",
        "description": "Connect to 3.3V power",
        "required": true
      },
      {
        "from_pin": "GND",
        "to_component": "esp32",
        "to_pin": "GND",
        "description": "Connect to ground",
        "required": true
      },
      {
        "from_pin": "SDA",
        "to_component": "esp32",
        "to_pin": "GPIO4",
        "description": "Data line (default GPIO4)",
        "required": true
      }
    ],
    "libraries": [
      "DHT sensor library",
      "Adafruit Unified Sensor"
    ],
    "unit_price_inr": 200.0,
    "price_source": "catalog_estimate",
    "price_verified_date": "2025-01-01",
    "electrical_constraints": [
      "Requires 10k\u03a9 pull-up resistor on data line (built-in on module versions)",
      "Minimum 2 seconds between readings",
      "Operating voltage: 3.3V to 5V"
    ],
    "description": "AM2302 digital temperature and humidity sensor, 0-100%RH, -40 to 80\u00b0C",
    "datasheet_url": "",
    "example_firmware": "\n#include <DHT.h>\n#define DHTPIN 4\n#define DHTTYPE DHT22\nDHT dht(DHTPIN, DHTTYPE);\nvoid setup() {\n  Serial.begin(115200);\n  dht.begin();\n}\nvoid loop() {\n  float h = dht.readHumidity();\n  float t = dht.readTemperature();\n  if (isnan(h) || isnan(t)) { Serial.println(\"DHT read failed\"); return; }\n  Serial.printf(\"Temp: %.1f\u00b0C  Humidity: %.1f%%\\n\", t, h);\n  delay(2000);\n}\n"
  },
